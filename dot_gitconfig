[user]
	name = Jhon Joe
	email = example@com
[core]
	pager = delta
[delta]
	navigate = true
	side-by-side = true
	syntax-theme = Catppuccin Mocha
[interactive]
	diffFilter = delta --color-only
[diff]
	colorMoved = default
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[fetch]
	prune = true
[ghq]
	root = ~/ghq
[include]
	path = ~/.gitconfig-local
